# Sanity project "HAA" — https://www.sanity.io/manage/project/itsaouhp
NEXT_PUBLIC_SANITY_PROJECT_ID="itsaouhp"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-06-01"

# Viewer token, for draft mode / the Presentation tool.
# Create one at https://www.sanity.io/manage/project/itsaouhp/api#tokens
SANITY_API_READ_TOKEN=""

# Editor token, for `npm run sanity:seed` and `npm run sanity:sync-nav`.
SANITY_API_WRITE_TOKEN=""

# Airtable, for `npm run network:import` and `npm run courses:import` — the
# /network and /courses directories' source. One token covers both bases.
# A personal access token with data.records:read on the base:
# https://airtable.com/create/tokens
AIRTABLE_TOKEN=""
# Only needed if a base, table or view moves.
# AIRTABLE_BASE_ID="appeEKu35B4MwL1jx"
# AIRTABLE_TABLE_ID="tblVfYoagUR5i3iGC"
# AIRTABLE_VIEW_ID="viwC5O43Hu2KTCpe9"
# AIRTABLE_COURSES_BASE_ID="appRyVWnOqGuk2Fxe"
# AIRTABLE_COURSES_TABLE_ID="tblKNbWUnmKI5lWyy"
